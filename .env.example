# 只填写实际启用的 Provider；禁止把本文件中的真实密钥提交到 Git。
# 默认安装仅包含 OpenAI；其他原生集成按 README 的可选依赖命令安装。
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude / Anthropic 原生 LangChain Provider。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Gemini / Google AI Studio 原生 LangChain Provider。
GOOGLE_API_KEY=

# DeepSeek 原生 LangChain Provider；deepseek-chat 支持本项目所需的结构化输出。
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=

# Qwen / DashScope 原生 LangChain Provider。
DASHSCOPE_API_KEY=
# DASHSCOPE_API_BASE=

# GLM 使用 LangChain ChatOpenAI 连接 ZhipuAI 的 OpenAI 兼容端点。
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=

# 任意符合 OpenAI Chat Completions 协议的第三方中转站。
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# 可选 JSON：用于 default_headers、extra_body 等中转站专有参数。
# OPENAI_COMPATIBLE_OPTIONS={"default_headers":{"X-Tenant":"tenant-a"}}

# OpenRouter 和 LiteLLM 建议使用各自专用 LangChain Provider。
OPENROUTER_API_KEY=
# LiteLLM 根据 model 名称读取其下游 Provider 的标准环境变量。

# 1.0.0 默认使用 SQLite；可覆盖 Alembic、十张应用表共用的数据库路径，且不得与 checkpoint 共用。
# FILE_GOVERNANCE_DATABASE_PATH=.artifacts/database/file-governance-app.sqlite3

# 可选：API、Worker、Scheduler 与 Alembic 共用的 SQLAlchemy URL；配置后优先于 SQLite 路径。
# PostgreSQL 凭据只应保存在本地 .env 或容器 Secret 中，不得写入请求 JSON。
# FILE_GOVERNANCE_DATABASE_URL=postgresql+psycopg://file_governance:change-me@127.0.0.1:55432/file_governance

# docker-compose.postgresql.yml 演示拓扑专用变量；生产环境应改用受管 Secret。
# 密码请只使用 URL 非保留字符 A-Z/a-z/0-9/._~-，避免未经编码直接拼接 URL。
FILE_GOVERNANCE_POSTGRES_DB=file_governance
FILE_GOVERNANCE_POSTGRES_USER=file_governance
FILE_GOVERNANCE_POSTGRES_PASSWORD=change-me-before-use
FILE_GOVERNANCE_POSTGRES_PORT=55432

# API 与独立 Worker 共用的持久化 LangGraph checkpoint。
# FILE_GOVERNANCE_CHECKPOINT_PATH=.artifacts/checkpoints/file-governance-background.sqlite3

# HTTP API 监听参数；本地默认只监听 127.0.0.1。
# FILE_GOVERNANCE_API_HOST=127.0.0.1
# FILE_GOVERNANCE_API_PORT=8000

# Background Worker 轮询、租约、心跳和失败重新入队参数。
# FILE_GOVERNANCE_WORKER_POLL_INTERVAL_SECONDS=1.0
# FILE_GOVERNANCE_WORKER_LEASE_SECONDS=30.0
# FILE_GOVERNANCE_WORKER_HEARTBEAT_INTERVAL_SECONDS=10.0
# FILE_GOVERNANCE_WORKER_RETRY_DELAY_SECONDS=1.0

# 独立 Scheduler 时区、计划表同步间隔和 Cron 后台任务最大尝试次数。
# FILE_GOVERNANCE_SCHEDULER_TIMEZONE=Asia/Shanghai
# FILE_GOVERNANCE_SCHEDULER_RECONCILE_INTERVAL_SECONDS=15.0
# FILE_GOVERNANCE_SCHEDULER_MAX_ATTEMPTS=3

# 四类独立服务统一输出的 JSON 日志级别。
# FILE_GOVERNANCE_LOG_LEVEL=INFO

# 邮件 MCP 证据默认关闭；启用后使用固定只读 Tool，失败会自动读取本地发送日志。
# FILE_GOVERNANCE_EMAIL_MCP_ENABLED=false
# FILE_GOVERNANCE_EMAIL_MCP_URL=http://127.0.0.1:8001/mcp

# 本地模拟邮件 MCP 的监听地址、端口和公开脱敏示例数据。
# FILE_GOVERNANCE_MOCK_EMAIL_MCP_HOST=127.0.0.1
# FILE_GOVERNANCE_MOCK_EMAIL_MCP_PORT=8001
# FILE_GOVERNANCE_MOCK_EMAIL_MCP_DATA_PATH=examples/mock_email_data.json

# 端到端演示脚本默认把生成数据、运行产物和备份写到被 Git 忽略的受控目录。
# FILE_GOVERNANCE_DEMO_ROOT=.artifacts/demo
